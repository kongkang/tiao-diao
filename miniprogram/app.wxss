/* ============ 全局样式（WeUI 视觉规范 + 适老化） ============
   字号策略：页面根节点由 JS 注入 font-size: 16px × fontScale，
   文字一律用 em 相对单位，跟随根字号自动放大（兼容大字版）。
   布局间距用 rpx（不随字号变，避免大字版排版散架）。
   主色：微信绿 #07C160（WeUI 规范）
   ================================================================ */

page {
  background: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #111;
  line-height: 1.7;
}

.page-root {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ---- 卡片 ---- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* ---- 按钮（WeUI primary 样式） ----
   四周留白规范：左右外边距 16rpx（叠加页面 24rpx padding，视觉距屏边 40rpx），
   文字上下内边距 28rpx、左右 40rpx，任何文案都不贴边框 */
.btn-primary {
  display: block;
  width: auto;
  box-sizing: border-box;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 24rpx;
  padding: 28rpx 40rpx;
  margin: 32rpx 16rpx 0;
  font-size: 1.15em;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.button-hover.btn-primary { background: #06ad56; }

.btn-plain {
  display: block;
  width: auto;
  box-sizing: border-box;
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 24rpx;
  padding: 24rpx 40rpx;
  margin: 20rpx 16rpx 0;
  font-size: 1.05em;
  font-weight: 500;
  text-align: center;
}
.btn-plain::after { border: none; }
.button-hover.btn-plain { background: #f0faf4; }

.btn-gray {
  display: block;
  width: auto;
  box-sizing: border-box;
  background: #fff;
  color: #5b6470;
  border: 2rpx solid #d9dde3;
  border-radius: 24rpx;
  padding: 24rpx 40rpx;
  margin: 20rpx 16rpx 0;
  font-size: 1em;
  text-align: center;
}
.btn-gray::after { border: none; }

/* ---- 文本 ---- */
.text-sub   { color: #8a8f98; }
.text-small { font-size: 0.85em; }
.text-bold  { font-weight: 600; }

/* ---- 表格式信息行 ---- */
.row-line {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 1em;
}
.row-line .k { color: #8a8f98; }
.row-line .v { color: #333; }

/* ---- 余额条 ---- */
.balance-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 32rpx;
  margin-bottom: 24rpx;
  font-size: 1em;
}
.balance-bar .num { font-size: 1.25em; font-weight: 700; color: #fa9d3b; }
.balance-bar .num.monthly { color: #07c160; }
