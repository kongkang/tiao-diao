.card-title {
  font-size: 1.05em;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.mono {
  font-family: Menlo, monospace;
  font-size: 0.85em;
  word-break: break-all;
}

.ok { color: #07c160; font-weight: 600; }

.tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  line-height: 1.6;
}

.sim-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.sim-btn {
  flex: 1 1 40%;
  margin: 0;
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 16rpx;
  padding: 18rpx 12rpx;
  font-size: 0.95em;
  line-height: 1.4;
}
.sim-btn::after { border: none; }
.button-hover.sim-btn { background: #f0faf4; }

.his-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.his-item:last-of-type { border-bottom: none; }
.his-main { flex: 1; min-width: 0; }
.his-name {
  font-size: 1em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
