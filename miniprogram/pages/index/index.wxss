.hero {
  text-align: center;
  padding: 56rpx 32rpx 48rpx;
}
.hero-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.hero-text {
  font-size: 1.05em;
  color: #333;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.card-title {
  font-size: 1.05em;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.guide-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 1em;
  line-height: 1.6;
}
.guide-num {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 0.9em;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  background: #f0f0f0;
  color: #666;
  border-radius: 10rpx;
  padding: 6rpx 20rpx;
  font-size: 0.85em;
}

.beta-note {
  background: #f0faf4;
  border: 2rpx solid #b7e2ca;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 0.95em;
  color: #1c5c3a;
  text-align: center;
}

/* ---- 最近转过 ---- */
.his-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.his-item:last-child { border-bottom: none; }
.his-main { flex: 1; min-width: 0; }
.his-name {
  font-size: 1em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 管理员入口 ---- */
.admin-entry {
  margin-top: 32rpx;
  text-align: center;
  font-size: 0.85em;
  color: #8a8f98;
  padding: 20rpx;
}
