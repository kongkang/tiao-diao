/* ---- 登录入口：吸在主卡右上角，不单独占行 ---- */
.me-entry {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 18rpx 6rpx 6rpx;
  background: #f4f6f8;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.10);
}
/* 外层裁圆 + overflow:hidden：真机直接给 image 打 border-radius 边框会变形 */
.me-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  background: #ececec;
  box-sizing: border-box;
}
.me-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.me-avatar-img.me-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.me-label {
  color: #5b6470;
  font-size: 0.85em;
}

.hero {
  position: relative;
  text-align: center;
  padding: 56rpx 32rpx 48rpx;
}
.hero-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.hero-text {
  font-size: 1.05em;
  color: #333;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.card-title {
  font-size: 1.05em;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.guide-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 1em;
  line-height: 1.6;
}
.guide-num {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 0.9em;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  background: #f0f0f0;
  color: #666;
  border-radius: 10rpx;
  padding: 6rpx 20rpx;
  font-size: 0.85em;
}

.beta-note {
  background: #f0faf4;
  border: 2rpx solid #b7e2ca;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 0.95em;
  color: #1c5c3a;
  text-align: center;
}

/* ---- 最近转过 ---- */
.his-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.his-item:last-child { border-bottom: none; }
.his-main { flex: 1; min-width: 0; }
.his-name {
  font-size: 1em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- 管理员入口 ---- */
.admin-entry {
  margin-top: 32rpx;
  text-align: center;
  font-size: 0.85em;
  color: #8a8f98;
  padding: 20rpx;
}
