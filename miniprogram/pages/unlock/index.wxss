/* 三档选择卡 */
.tier {
  background: #fff;
  border: 4rpx solid #e6e6e6;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  position: relative;
}
.tier.sel {
  border-color: #07c160;
  background: #f4fcf7;
}
.tier-icon {
  font-size: 54rpx;
  line-height: 1.15;
  flex: 0 0 auto;
}
.tier-main {
  flex: 1;
  min-width: 0;
  padding-right: 44rpx;
}
.tier-title {
  font-size: 1.12em;
  font-weight: 700;
  color: #222;
  line-height: 1.35;
}
.tier-desc {
  font-size: 0.92em;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.45;
}
.tier-link {
  font-size: 0.92em;
  color: #07c160;
  font-weight: 600;
  margin-top: 10rpx;
}
.tier-badge {
  display: inline-block;
  font-size: 0.7em;
  font-weight: 500;
  color: #07c160;
  background: #e8f8ef;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 8rpx;
  vertical-align: 2rpx;
}
.tier-check {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

/* 底部按钮：只显示所选档位名，单行 */
.convert-btn {
  margin-top: 10rpx;
  white-space: nowrap;
}
