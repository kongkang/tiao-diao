<view class="page-root" style="font-size:{{fontScale * 16}}px;">

  <!-- 信息卡 -->
  <view class="card">
    <view class="row-line"><text class="k">音乐</text><text class="v">{{song.name}}</text></view>
    <view class="row-line"><text class="k">时长</text><text class="v">{{durationText}}（算 {{billing.minutes}} 分钟）</text></view>
    <view class="row-line"><text class="k">调整</text><text class="v">{{pitchLabel}}</text></view>
  </view>

  <!-- 三档：免费 / 额度 / 包月 -->
  <view class="tier {{selected === 'free' ? 'sel' : ''}}" data-v="free" bindtap="onPick">
    <view class="tier-icon">📺</view>
    <view class="tier-main">
      <view class="tier-title">限时免费</view>
      <view class="tier-desc">感谢您关注 亢铨宝 视频号</view>
    </view>
    <view class="tier-check" wx:if="{{selected === 'free'}}">✓</view>
  </view>

  <view class="tier {{selected === 'balance' ? 'sel' : ''}}" data-v="balance" bindtap="onPick">
    <view class="tier-icon">⏱</view>
    <view class="tier-main">
      <view class="tier-title">额度下载</view>
      <view class="tier-desc">当前余额 {{entitlement.minutes}} 分钟，本次消耗 {{billing.minutes}} 分钟</view>
      <view class="tier-link" wx:if="{{!entitlement.monthly}}" catchtap="onGoRecharge">限时优惠 {{rechargePriceText}} 元得 {{rechargeMinutes}} 分钟 ›</view>
    </view>
    <view class="tier-check" wx:if="{{selected === 'balance'}}">✓</view>
  </view>

  <view class="tier {{selected === 'monthly' ? 'sel' : ''}}" data-v="monthly" bindtap="onPick">
    <view class="tier-icon">🎫</view>
    <view class="tier-main">
      <view class="tier-title">包月下载
        <text class="tier-badge" wx:if="{{entitlement.monthly}}">已开通 · 剩 {{entitlement.monthlyDaysLeft}} 天</text>
      </view>
      <view class="tier-desc">30 天无限量</view>
      <view class="tier-desc">不用看视频，不用算分钟数</view>
      <view class="tier-link" wx:if="{{!entitlement.monthly}}" catchtap="onGoMonthly">¥{{monthlyPriceText}} 开通 ›</view>
    </view>
    <view class="tier-check" wx:if="{{selected === 'monthly'}}">✓</view>
  </view>

  <button class="btn-primary convert-btn" bindtap="onConfirm">{{confirmText}}</button>

  <!-- 赞赏入口：全小程序仅此一处（官方限制只能一个） -->
  <reward-entry />

</view>
