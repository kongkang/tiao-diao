.top-warn {
  background: #fff6ec;
  border: 2rpx solid #f5d3a8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  font-size: 1em;
  color: #8a4d00;
}
.bold { font-weight: 700; }

.pkg {
  background: #fff;
  border: 4rpx solid #e6e6e6;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.pkg.sel { border-color: #07c160; background: #f4fcf7; }
.pkg-name { font-size: 1.1em; font-weight: 600; }
.pkg-desc { font-size: 0.88em; color: #8a8f98; }
.pkg-price {
  margin-left: auto;
  font-size: 1.4em;
  font-weight: 700;
  color: #fa9d3b;
}
.pkg-hot {
  background: #fa9d3b;
  color: #fff;
  font-size: 0.65em;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-left: 16rpx;
  vertical-align: middle;
}

.beta-note {
  background: #f0faf4;
  border: 2rpx solid #b7e2ca;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 0.95em;
  color: #1c5c3a;
  text-align: center;
  margin-top: 24rpx;
}

/* ============ 支付等待 / 到账庆祝 ============ */
.pay-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  overflow: hidden;
}
.pay-card {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 44rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  animation: payPop 0.3s ease-out both;
}
@keyframes payPop {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.pay-spinner {
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 24rpx;
  border: 6rpx solid #e6f7ee;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.pay-title {
  font-size: 1.15em;
  font-weight: 700;
  color: #222;
}
.pay-sub {
  font-size: 0.9em;
  color: #777;
  margin-top: 12rpx;
  line-height: 1.5;
}
.pay-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
}
.pay-dots .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07c160;
  opacity: 0.25;
  animation: blink 1.2s infinite;
}
.pay-dots .d2 { animation-delay: 0.2s; }
.pay-dots .d3 { animation-delay: 0.4s; }
@keyframes blink {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.1); }
}
.pending-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.pending-btn {
  margin-top: 28rpx;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 1em;
  line-height: 2.4;
}

/* 成功庆祝 */
.success-mask { background: rgba(0, 0, 0, 0.55); }
.confetti {
  position: absolute;
  font-size: 44rpx;
  animation: floatUp 2.4s ease-in-out infinite;
}
.c1 { left: 10%; top: 18%; animation-delay: 0s; }
.c2 { right: 12%; top: 16%; animation-delay: 0.3s; }
.c3 { left: 16%; bottom: 22%; animation-delay: 0.6s; }
.c4 { right: 16%; bottom: 18%; animation-delay: 0.9s; }
.c5 { left: 42%; top: 8%; animation-delay: 0.45s; }
.c6 { right: 36%; bottom: 10%; animation-delay: 0.75s; }
@keyframes floatUp {
  0%, 100% { transform: translateY(0) rotate(0); opacity: 0.85; }
  50% { transform: translateY(-28rpx) rotate(8deg); opacity: 1; }
}
.success-card {
  position: relative;
  z-index: 2;
  width: 600rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 52rpx 40rpx 44rpx;
  text-align: center;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.25);
  animation: successPop 0.5s cubic-bezier(0.2, 1.5, 0.4, 1) both;
}
@keyframes successPop {
  0% { transform: scale(0.6); opacity: 0; }
  70% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1); }
}
.success-icon {
  font-size: 96rpx;
  animation: bounce 1.2s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.success-title {
  font-size: 1.35em;
  font-weight: 800;
  color: #07c160;
  margin-top: 12rpx;
}
.success-amount {
  font-size: 1.6em;
  font-weight: 800;
  color: #fa9d3b;
  margin-top: 16rpx;
}
.success-sub {
  font-size: 0.92em;
  color: #666;
  margin-top: 14rpx;
  line-height: 1.5;
}
.success-btn {
  margin-top: 32rpx;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 1.05em;
  font-weight: 600;
  line-height: 2.6;
}
.success-again,
.pending-again {
  margin-top: 18rpx;
  font-size: 0.9em;
  color: #999;
  text-align: center;
}
.success-btn::after,
.pending-btn::after { border: none; }
