.process-card {
  text-align: center;
  padding: 80rpx 40rpx;
}
.percent {
  font-size: 3.2em;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 32rpx;
}
.pbar {
  width: 100%;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.pbar-fill {
  height: 100%;
  background: #07c160;
  border-radius: 10rpx;
  transition: width .3s ease;
}
.process-title {
  font-size: 1.15em;
  font-weight: 600;
  margin-bottom: 8rpx;
}
