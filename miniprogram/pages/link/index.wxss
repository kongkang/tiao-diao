.sec-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.url-box {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 20rpx;
  background: #f6f7f9;
  border-radius: 16rpx;
  font-size: 1em;
  line-height: 1.5;
}

.url-ph {
  color: #b0b4bc;
}

.row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.row-btn {
  flex: 1;
  font-size: 0.9em;
}

.meta {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  overflow: hidden;
}

.cover-ph {
  background: #f0faf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.meta-main {
  flex: 1;
  min-width: 0;
}

.meta-title {
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 0.75em;
  color: #06ad56;
  background: #f0faf4;
  border-radius: 999rpx;
}
