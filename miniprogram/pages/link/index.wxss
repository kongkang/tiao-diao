.sec-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.url-box {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 20rpx;
  background: #f6f7f9;
  border-radius: 16rpx;
  font-size: 1em;
  line-height: 1.5;
}

.url-ph {
  color: #b0b4bc;
}

.row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.row-btn {
  flex: 1;
  font-size: 0.9em;
}

.meta {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  overflow: hidden;
}

.cover-ph {
  background: #f0faf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.meta-main {
  flex: 1;
  min-width: 0;
}

.meta-title {
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 0.75em;
  color: #06ad56;
  background: #f0faf4;
  border-radius: 999rpx;
}

/* 视频太长:选一段 */
.slice-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fff8e6;
  border-radius: 16rpx;
}

.slice-tip {
  line-height: 1.5;
  white-space: pre-line;
}

.slice-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
}

.slice-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 1.2em;
  color: #07c160;
  background: #fff;
  border: 2rpx solid #07c160;
}

.slice-btn::after {
  border: none;
}

.slice-main {
  min-width: 260rpx;
  text-align: center;
}

.slice-num {
  font-weight: 600;
  margin-bottom: 4rpx;
}
